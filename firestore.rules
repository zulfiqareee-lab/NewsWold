rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "zulfiqareee@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. News Articles
    match /news/{articleId} {
      // Public visitors can read published news only. Admins can read all drafts.
      allow get, list: if resource.data.status == 'published' || isAdmin();
      // Only authenticated and authorized administrators can create, edit, approve, publish or delete news.
      allow create, update, delete: if isAdmin();
    }

    // 2. Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. News Sources
    match /news_sources/{sourceId} {
      allow read, write: if isAdmin();
    }

    // 4. Facebook Post Logs
    match /facebook_post_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 5. Copyright Complaints
    match /copyright_complaints/{complaintId} {
      // Anyone can submit a copyright takedown complaint
      allow create: if true;
      // Only administrators can review and resolve complaints
      allow read, update, delete: if isAdmin();
    }

    // 6. Admins
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
